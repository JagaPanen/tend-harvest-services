# ── App ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/harvest_expedition
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/harvest_expedition

# ── Mapbox ──
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# ── Optimization defaults ──
ALPHA_TRAVEL_COST=0.4
BETA_DETOUR_COST=0.3
GAMMA_SPOILAGE_RISK=0.3

# ── Server ──
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ── Currency & Units ──
DEFAULT_CURRENCY=IDR
DEFAULT_VOLUME_UNIT=kg
COST_PER_KM_IDR=5000
