# ── Postgres (Docker Compose + local) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=harvest_expedition
# Host port when publishing the compose postgres service
POSTGRES_HOST_PORT=5433

# ── App (host / local uvicorn — use localhost + POSTGRES_HOST_PORT) ──
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5433/harvest_expedition
DATABASE_URL_SYNC=postgresql://postgres:change-me@localhost:5433/harvest_expedition

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72
GUEST_JWT_EXPIRE_HOURS=2
GUEST_MAX_OPTIMIZE_RUNS=5

# ── Billing / plans (P4) ──
# Set PILOT_MAX_OPTIMIZE_RUNS=3 locally to demo hard-stop quickly.
PILOT_MAX_OPTIMIZE_RUNS=25
PILOT_DAYS=14
STARTER_MAX_OPTIMIZE_RUNS=200
FLEET_MAX_OPTIMIZE_RUNS=1000
USAGE_SOFT_CAP_RATIO=0.8
BILLING_STUB=true
BILLING_PUBLIC_APP_URL=http://127.0.0.1:3000
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# ── Mapbox / OSRM (Mapbox preferred; OSRM when token empty) ──
MAPBOX_ACCESS_TOKEN=
OSRM_BASE_URL=https://router.project-osrm.org

# ── Optimization defaults ──
ALPHA_TRAVEL_COST=0.4
BETA_DETOUR_COST=0.3
GAMMA_SPOILAGE_RISK=0.3

# ── Server ──
API_HOST=0.0.0.0
API_PORT=8009
DEBUG=true

# ── Currency & Units ──
DEFAULT_CURRENCY=IDR
DEFAULT_VOLUME_UNIT=kg
COST_PER_KM_IDR=5000
